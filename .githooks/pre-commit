#!/usr/bin/env sh
# Branch per feature; the trunk moves by merge (same rule as the basis monorepo).
# `development` is the trunk, `live` is the release branch (moves by merge, tagged per release; the same
# convention as the basis monorepo). The old `master` is kept protected until it is deleted.
branch="$(git symbolic-ref --short HEAD 2>/dev/null)"
case "$branch" in
  master|development|live)
    if [ "${ALLOW_PROTECTED_COMMIT:-}" = "1" ]; then exit 0; fi
    echo "✖ refusing to commit directly on '$branch'." >&2
    echo "  Branch first:  git switch -c feat/<what-you-are-doing>" >&2
    echo "  Then open a PR into development; live takes releases (merged from development, tagged) and hotfixes." >&2
    echo "  (Deliberate exception: ALLOW_PROTECTED_COMMIT=1 git commit …)" >&2
    exit 1 ;;
esac
exit 0
