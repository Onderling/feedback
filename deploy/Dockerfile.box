# The feedback repo as ONE image for the box roles (deploy/roles/*): the activation service, the
# portal, the per-project Telegram bots and the aggregation runner all run from it with a different
# command. Build context = the feedback repo root. Dependency-light: the app deps, the Solid auth lib
# for the owner's DPoP fetch, and the @onderling/* packages the Telegram bridge needs.
# pinned by digest so a box rollback rebuilds exactly the previous release; re-vet + re-pin to update
FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git python3 make g++ && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json* ./
RUN npm install --omit=dev && npm install @inrupt/solid-client-authn-core
COPY src ./src
COPY scripts ./scripts
COPY templates ./templates
EXPOSE 8787 8080
USER node
CMD ["node", "scripts/project.js", "run"]
